//
// Computation in Earth Engine 
// 

// The problem - problem w/ radar instrument resulting in all topographical features underestimated by 100m 

// Import SRTM data 
var dataset =ee.Image("CGIAR/SRTM90_V4"); // import elevation image
print (dataset);

var elevationVis = {min:0,max:2500,palette: ['darkblue','lightblue','yellow']}; // set elevation visual custom parameters

Map.addLayer(dataset,elevationVis,'Elevation',true, 0.6); // add elevation visual layer to map, 0.6 changes the opacity so can still see satellite image underneath 

var strm_fixed = dataset.add(100); // adds 100 onto each integer value (for each pixel in the raster - correcting problem caused by radar)
Map.addLayer(strm_fixed,elevationVis,'Fixed STRM', true, 0.6);

var elevGt1500 = dataset.gt(1500); // filters pixels to show only those with an elevation greater than 1500 
Map.addLayer(elevGt1500); // binary output, greater than 1500 = white, not greater = black 

var elevGt1500 = dataset.gt(1500).selfMask();
Map.addLayer(elevGt1500); // masks every 0 value (not greater than 1500m) out of the image - better for visualistics and means no other operations performed are applied to it 

Map.addLayer(elevGt1500.selfMask(), {palette:'fuchsia'}, 'GT 1500m',true, 0.7);

var terrain = ee.Terrain.products(dataset); // use terrain (algorithm that returns several topographic variables from an elevation image)
print('Terrain',terrain); // four bands within - elevation, slope, aspect, hillshade

var slope = terrain.select(['slope']); // create images from the bands (within terrain) that we are interested in
var hillshade = terrain.select(['hillshade']); 
Map.addLayer(hillshade);
Map.addLayer(slope,{palette: ['white','darkblue','black'],min:0,max:45},'slope');

// 
// Spatial Reducers 
// 

var taranaki = protected_area.filter(ee.Filter.eq('NAME','Egmont National Park')); // uncommented protected_area creation in code above 
Map.addLayer(taranaki, {color:'orange'},'Mt Taranaki')

var slopeOutput = slope.reduceRegion({ // apply spatial reducer to estimate mean slope of Mt Taranki NP
  reducer:ee.Reducer.mean(), // compute mean of all slope pixel values in NP 
  geometry: taranaki, //the geometry we created above
  scale: 90 // pixel size in metres (from NP metadata)
})
print('slopeOutput',slopeOutput) // mean slope = 10.036 degrees 

// In ArcGIS, would clip the elevation (STRM) layer first to the Mt Taranaki NP - compare whether clipping first or just applying 'geometry' argument reduces the analysis 

var taranakiSlope = slope.clip(taranaki);
Map.addLayer(taranakiSlope,{palette: ['white','darkblue','black'],min:0,max:45},'taranaki slope');

var slopeOutput2 = taranakiSlope.reduceRegion({
  reducer: ee.Reducer.mean(),
  geometry: taranaki,
  scale: 90
}); // generate second slope output using the pre-clipped slope
print('slopeOutput2',slopeOutput2); // mean slope = 10.036 degrees - same as using the geometry to clip (as output one)

var elevOutput_Max = dataset.reduceRegion({
  reducer:ee.Reducer.max(),
  geometry: taranaki,
  scale: 90
});
print('elevOutput_Max',elevOutput_Max); // max elevation = 2484m 

var elevOutput_Min = dataset.reduceRegion({
  reducer:ee.Reducer.min(),
  geometry:taranaki, 
  scale: 90
}); 
print('elevOutput_Min',elevOutput_Min) // min elevation = 108m 

// LOTS of different reducers available 

var elevOutput_MinMax = dataset.reduceRegion({
  reducer:ee.Reducer.minMax(), // different reducer - calculates min and max in one command!!
  geometry: taranaki,
  scale:90
}); 
print('elevOutput_MinMax',elevOutput_MinMax) // max = 2484m, min = 108m 

// EXAMPLE: finding the area (km2) of Mt Taranaki NP that is above 1500m elevation threshold 

var areaGt1500m = elevGt1500 
  .multiply(ee.Image.pixelArea()) // generates area of each pixel 
  .reduceRegion({
    reducer:ee.Reducer.sum(), // sum of all pixels together (total area)
    geometry: taranaki,
    scale:90 
  })
print('The area of Mt Taranaki NP above 1500m (m2)',areaGt1500m) // area >1500m = 11,474,443.341m2
print('The area of Mt Taranaki NP above 1500m (km2)', ee.Number(areaGt1500m.get('elevation')).divide(1000*1000)) // area >1500m = 11.474km2

