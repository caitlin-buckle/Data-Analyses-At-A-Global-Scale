// Planning a Reef Field Trip 

// Global Variables 

var distance = 800; // 800m allowed to snorkel from the station 

Map.setOptions('SATELLITE'); 
// Map.setCenter(113.7764,-23.1447,17); // used to find the different research stations

var field_stations = ee.FeatureCollection([hamilton_island,heron_island,lizard_island,daydream_island,orpheus_island,kimberley_station,coral_bay]);
print(field_stations);

// import Allen coral atlas (ACA) data into GEE

var ACA = ee.Image("ACA/reef_habitat/v2_0"); 
print(ACA);

Map.addLayer(ACA);

// Select the appropriate band to access benthic (not geomorphic data)
var benthic = ee.Image("ACA/reef_habitat/v2_0").select('benthic'); 
print(benthic);

// extract coral cover band from benthic band 

var coral = benthic
  .eq(15) // pixel value of coral/algae is 15 (found in ACA info in catalogue) - returns 1 if true, 0 if false
  .selfMask(); // mask out all non-coral/algae pixels (0 values)
print(coral); 

Map.addLayer(coral,{palette:'coral'},'Coral only'); //add layer with coral and algae

var station_buffer = ee.Feature(field_stations.first()).buffer(800); // buffer around the first feature 
Map.addLayer(station_buffer,{palette:'yellow'},'Station Buffer');

// To run as a .map - looping over all stations 
var buffer_loop = function (feature){
  var buffered = feature.buffer(800) // applies a 800m buffer when given a feature 
  return buffered;
}; 

var out = field_stations.map(buffer_loop);
print(out, 'out'); 
Map.addLayer(out,{color:'yellow'},'Buffer loop'); 

var area_pixels = ee.Image(ee.Image.pixelArea()).updateMask(coral);

var area_out = area_pixels.reduceRegions({
  reducer:ee.Reducer.sum(),
  collection:out, 
  scale:5
}); 

print(area_out,'area_out'); 

// Clean it up 

var cleaner = function (feature){
  var clean = {
    station_name: feature.get('Field_Station'),
    area_m2: ee.Number(feature.get('sum')),
    area_km2:ee.Number(feature.get('sum')).divide(1000*1000),
    analyst: 'caitlin'
  }
  return feature.set(clean)
}

var cleaned_result = area_out.map(cleaner).sort('area_km2',false)
print(cleaned_result,'cleaned')